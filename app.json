{
  "expo": {
    "name": "SpeakEasy",
    "slug": "SpeakEasy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5EFD9",
        "foregroundImage": "./assets/logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Allow SpeakEasy to access your microphone for speech practice recordings."
        }
      ]
    ]
  }
}
